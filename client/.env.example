# URL do servidor (padrão: http://localhost:3001). Em produção: https://SEU_DOMINIO
VITE_SERVER_URL=http://localhost:3001

# Servidores ICE para as chamadas de voz (JSON). Padrão: STUN público do Google (pessoas atrás de NAT).
# Para usar STUN/TURN próprio:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.interna.exemplo:3478"},{"urls":"turn:turn.interna.exemplo:3478","username":"u","credential":"p"}]
# Para não usar nenhum servidor externo (só rede local/VPN):
# VITE_ICE_SERVERS=[]
