# Copie para .env (NUNCA faça commit do .env). Gere os segredos com:
#   openssl rand -hex 32        -> JWT_SECRET
#   openssl rand -base64 32     -> DATA_ENCRYPTION_KEY
NODE_ENV=production
PORT=3001

# Segredo de assinatura da sessão (>= 32 caracteres). Obrigatório em produção.
JWT_SECRET=
# Chave AES-256 (32 bytes em base64) para criptografar mensagens em repouso. Obrigatória em produção.
# Se perder essa chave, as mensagens gravadas ficam ilegíveis: guarde uma cópia em local seguro.
DATA_ENCRYPTION_KEY=

# Onde ficam database.sqlite e uploads/ (no Docker: /data, mapeado para um volume)
DATA_DIR=/data

# Origens autorizadas (CORS/WebSocket), separadas por vírgula.
# Padrão: Vite em desenvolvimento e o app Electron empacotado.
CORS_ORIGINS=http://localhost:5173,app://radio-esgoto

# Atrás do Caddy/Nginx: número de proxies confiáveis e HTTPS obrigatório
TRUST_PROXY=1
FORCE_HTTPS=true
# Domínio público (usado no redirecionamento para HTTPS)
PUBLIC_HOST=
# Cookie de sessão. Em produção: SameSite=none + Secure (exige HTTPS).
COOKIE_SAMESITE=none
COOKIE_SECURE=true
